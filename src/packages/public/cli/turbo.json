{
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "generated/**",
        "!**/*.test.*"
      ],
      "env": [
        "CARGO_BUILD_TARGET",
        "RUNNER_OS",
        "RUNNER_ARCH",
        "RUSTUP_TOOLCHAIN",
        "CARGO_PROFILE_DEV_DEBUG",
        "CARGO_PROFILE_TEST_DEBUG",
        "CARGO_INCREMENTAL"
      ],
      "outputs": [
        "dist/**",
        "target/release/interfere",
        "target/release/interfere.exe",
        "target/*/release/interfere",
        "target/*/release/interfere.exe"
      ],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "generated/**"
      ],
      "env": [
        "CARGO_BUILD_TARGET",
        "RUNNER_OS",
        "RUNNER_ARCH",
        "RUSTUP_TOOLCHAIN",
        "CARGO_PROFILE_DEV_DEBUG",
        "CARGO_PROFILE_TEST_DEBUG",
        "CARGO_INCREMENTAL"
      ],
      "outputs": [],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME"
      ],
      "tags": []
    },
    "test:wire": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "generated/**"
      ],
      "env": [
        "CARGO_BUILD_TARGET",
        "RUNNER_OS",
        "RUNNER_ARCH",
        "RUSTUP_TOOLCHAIN",
        "CARGO_PROFILE_DEV_DEBUG",
        "CARGO_PROFILE_TEST_DEBUG",
        "CARGO_INCREMENTAL"
      ],
      "outputs": [],
      "passThroughEnv": [
        "CARGO_HOME",
        "RUSTUP_HOME"
      ]
    },
    "generate": {
      "dependsOn": [
        "@interfere/gateway#typegen"
      ],
      "cache": false,
      "passThroughEnv": [
        "CARGO_*",
        "CARGO_HOME",
        "RUSTUP_HOME"
      ]
    }
  },
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tags": [
    "public"
  ]
}
