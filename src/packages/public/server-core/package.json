{
  "name": "@interfere/server-core",
  "version": "0.3.0",
  "description": "Shared telemetry runtime for Interfere server adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfere-inc/sdks.git",
    "directory": "src/packages/public/server-core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#otlp-http": {
      "workerd": {
        "types": "./dist/otlp/web.d.mts",
        "default": "./dist/otlp/web.mjs"
      },
      "edge-light": {
        "types": "./dist/otlp/web.d.mts",
        "default": "./dist/otlp/web.mjs"
      },
      "node": {
        "types": "./dist/otlp/node.d.mts",
        "default": "./dist/otlp/node.mjs"
      },
      "types": "./dist/otlp/web.d.mts",
      "default": "./dist/otlp/web.mjs"
    },
    "#otel/core/platform": {
      "node": "./dist/vendor/@opentelemetry/core/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/core/platform/browser.mjs"
    },
    "#otel/sdk-trace/platform": {
      "node": "./dist/vendor/@opentelemetry/sdk-trace/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/sdk-trace/platform/browser.mjs"
    },
    "#otel/resources/platform": {
      "node": "./dist/vendor/@opentelemetry/resources/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/resources/platform/browser.mjs"
    },
    "#otel/instrumentation/platform": {
      "node": "./dist/vendor/@opentelemetry/instrumentation/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/instrumentation/platform/browser.mjs"
    },
    "#otel/sdk-logs/platform": {
      "node": "./dist/vendor/@opentelemetry/sdk-logs/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/sdk-logs/platform/browser.mjs"
    },
    "#otel/exporter-metrics-otlp-http/platform": {
      "node": "./dist/vendor/@opentelemetry/exporter-metrics-otlp-http/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/exporter-metrics-otlp-http/platform/browser.mjs"
    },
    "#otel/otlp-transformer/platform": {
      "node": "./dist/vendor/@opentelemetry/otlp-transformer/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/otlp-transformer/platform/browser.mjs"
    }
  },
  "exports": {
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./ownership": {
      "types": "./dist/ownership.d.mts",
      "default": "./dist/ownership.mjs"
    },
    "./console-bridge": {
      "types": "./dist/console-bridge.d.mts",
      "default": "./dist/console-bridge.mjs"
    },
    "./contain": {
      "types": "./dist/contain.d.mts",
      "default": "./dist/contain.mjs"
    },
    "./global-handlers": {
      "types": "./dist/global-handlers.d.mts",
      "default": "./dist/global-handlers.mjs"
    },
    "./shutdown": {
      "types": "./dist/shutdown.d.mts",
      "default": "./dist/shutdown.mjs"
    },
    "./contained-span-processor": {
      "types": "./dist/contained-span-processor.d.mts",
      "default": "./dist/contained-span-processor.mjs"
    },
    "./credential": {
      "types": "./dist/credential.d.mts",
      "default": "./dist/credential.mjs"
    },
    "./otlp-http": {
      "types": "./dist/otlp-http.d.mts",
      "default": "./dist/otlp-http.mjs"
    },
    "./otel/*": {
      "types": "./dist/otel/*.d.mts",
      "default": "./dist/otel/*.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --no-clean --no-dts --watch",
    "lint": "cd ../../../.. && GOMAXPROCS=2 oxlint --max-warnings=0 --report-unused-disable-directives-severity=error --threads=2 src/packages/public/server-core",
    "test": "node ../test-config/src/cli.ts run --config ../../../../vitest.config.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@interfere/constants": "workspace:^",
    "@interfere/helpers": "workspace:^",
    "@interfere/types": "workspace:^",
    "import-in-the-middle": "catalog:",
    "require-in-the-middle": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@interfere/test-config": "workspace:*",
    "@interfere/test-utils": "workspace:^",
    "@interfere/typescript-config": "workspace:^",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/otlp-exporter-base": "catalog:",
    "@opentelemetry/otlp-transformer": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@types/node": "catalog:",
    "msw": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2"
  },
  "engines": {
    "node": "24.x"
  }
}
