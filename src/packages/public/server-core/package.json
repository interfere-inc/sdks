{
  "name": "@interfere/server-core",
  "version": "0.1.3",
  "description": "Shared telemetry runtime for Interfere server adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfere-inc/sdks.git",
    "directory": "src/packages/public/server-core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./runtime": {
      "monorepo": "./src/runtime.ts",
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./node": {
      "monorepo": "./src/node.ts",
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./ownership": {
      "monorepo": "./src/ownership.ts",
      "types": "./dist/ownership.d.mts",
      "default": "./dist/ownership.mjs"
    },
    "./console-bridge": {
      "monorepo": "./src/console-bridge.ts",
      "types": "./dist/console-bridge.d.mts",
      "default": "./dist/console-bridge.mjs"
    },
    "./contain": {
      "monorepo": "./src/contain.ts",
      "types": "./dist/contain.d.mts",
      "default": "./dist/contain.mjs"
    },
    "./global-handlers": {
      "monorepo": "./src/global-handlers.ts",
      "types": "./dist/global-handlers.d.mts",
      "default": "./dist/global-handlers.mjs"
    },
    "./shutdown": {
      "monorepo": "./src/shutdown.ts",
      "types": "./dist/shutdown.d.mts",
      "default": "./dist/shutdown.mjs"
    },
    "./contained-span-processor": {
      "monorepo": "./src/contained-span-processor.ts",
      "types": "./dist/contained-span-processor.d.mts",
      "default": "./dist/contained-span-processor.mjs"
    },
    "./credential": {
      "monorepo": "./src/credential.ts",
      "types": "./dist/credential.d.mts",
      "default": "./dist/credential.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint:oxlint": "cd ../../../.. && GOMAXPROCS=2 oxlint --max-warnings=0 --report-unused-disable-directives-severity=error --threads=2 src/packages/public/server-core",
    "test": "node ../test-config/src/cli.ts run --config ../../../../vitest.config.ts",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@interfere/constants": "workspace:^",
    "@interfere/helpers": "workspace:^",
    "@interfere/types": "workspace:^",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/otlp-exporter-base": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:"
  },
  "devDependencies": {
    "@interfere/test-config": "workspace:*",
    "@interfere/test-utils": "workspace:^",
    "@interfere/typescript-config": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
