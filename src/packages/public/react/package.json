{
  "name": "@interfere/react",
  "version": "13.2.0",
  "description": "Client-side React SDK for Interfere. Error tracking, session replay, and analytics.",
  "keywords": [
    "error-tracking",
    "observability",
    "react",
    "session-replay",
    "typescript"
  ],
  "homepage": "https://interfere.com",
  "bugs": "mailto:support@interfere.com",
  "license": "MIT",
  "author": "Interfere <support@interfere.com> (https://interfere.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfere-inc/sdks.git",
    "directory": "src/packages/public/react"
  },
  "files": [
    "dist",
    "!dist/internal/test",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#otel/core/platform": {
      "node": "./dist/vendor/@opentelemetry/core/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/core/platform/browser.mjs"
    },
    "#otel/instrumentation/platform": {
      "node": "./dist/vendor/@opentelemetry/instrumentation/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/instrumentation/platform/browser.mjs"
    },
    "#otel/otlp-transformer/platform": {
      "node": "./dist/vendor/@opentelemetry/otlp-transformer/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/otlp-transformer/platform/browser.mjs"
    },
    "#otel/resources/platform": {
      "node": "./dist/vendor/@opentelemetry/resources/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/resources/platform/browser.mjs"
    },
    "#otel/sdk-logs/platform": {
      "node": "./dist/vendor/@opentelemetry/sdk-logs/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/sdk-logs/platform/browser.mjs"
    },
    "#otel/sdk-trace/platform": {
      "node": "./dist/vendor/@opentelemetry/sdk-trace/platform/node.mjs",
      "default": "./dist/vendor/@opentelemetry/sdk-trace/platform/browser.mjs"
    }
  },
  "exports": {
    "./provider": {
      "types": "./dist/provider.d.mts",
      "default": "./dist/provider.mjs"
    },
    "./error-boundary": {
      "types": "./dist/error-boundary.d.mts",
      "default": "./dist/error-boundary.mjs"
    },
    "./react-error-handler": {
      "types": "./dist/react-error-handler.d.mts",
      "default": "./dist/react-error-handler.mjs"
    },
    "./api": {
      "types": "./dist/api.d.mts",
      "default": "./dist/api.mjs"
    },
    "./internal/kernel": {
      "types": "./dist/internal/kernel.d.mts",
      "default": "./dist/internal/kernel.mjs"
    },
    "./internal/kernel-registry": {
      "types": "./dist/internal/kernel-registry.d.mts",
      "default": "./dist/internal/kernel-registry.mjs"
    },
    "./internal/version": {
      "types": "./dist/internal/version.d.mts",
      "default": "./dist/internal/version.mjs"
    },
    "./internal/wrapper-singleton": {
      "types": "./dist/internal/wrapper-singleton.d.mts",
      "default": "./dist/internal/wrapper-singleton.mjs"
    },
    "./sw-runtime": {
      "types": "./dist/internal/sw/queue.d.mts",
      "default": "./dist/internal/sw/queue.mjs"
    },
    "./util/global": {
      "types": "./dist/util/global.d.mts",
      "default": "./dist/util/global.mjs"
    },
    "./util/log": {
      "types": "./dist/util/log.d.mts",
      "default": "./dist/util/log.mjs"
    },
    "./request-trace": {
      "types": "./dist/request-trace.d.mts",
      "default": "./dist/request-trace.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --no-clean --no-dts --watch",
    "lint": "cd ../../../.. && GOMAXPROCS=2 oxlint --max-warnings=0 --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern --threads=2 src/packages/public/react",
    "test": "node ../test-config/src/cli.ts run --config ../../../../vitest.config.ts",
    "test:artifact": "node --test --test-timeout=30000 test/recorder-artifact.test.mts test/react-key-deopt-artifact.test.mts",
    "test:runtime": "vitest run --config vitest.sdk-browser.config.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "catalog:",
    "@interfere/constants": "workspace:^",
    "@interfere/helpers": "workspace:^",
    "@interfere/javascript": "workspace:^",
    "@interfere/types": "workspace:^",
    "fflate": "catalog:",
    "import-in-the-middle": "catalog:",
    "isbot": "catalog:",
    "require-in-the-middle": "catalog:",
    "uuid": "catalog:",
    "web-vitals": "catalog:",
    "workbox-background-sync": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@datadog/browser-rum": "catalog:",
    "@interfere/test-config": "workspace:*",
    "@interfere/typescript-config": "workspace:^",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/browser-instrumentation": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-document-load": "catalog:",
    "@opentelemetry/instrumentation-long-task": "catalog:",
    "@opentelemetry/opentelemetry-browser-detector": "catalog:",
    "@opentelemetry/otlp-transformer": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@opentelemetry/web-common": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@rrweb/types": "catalog:",
    "@sentry/browser": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "minimatch": "catalog:",
    "msw": "catalog:",
    "playwright": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rrweb": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": "24.x"
  }
}
