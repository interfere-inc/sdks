{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["public", "compiled"],
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "tags": ["$TURBO_EXTENDS$", "test-react"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "test:artifact": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:runtime": {
      "dependsOn": ["typegen", "^build"],
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}
