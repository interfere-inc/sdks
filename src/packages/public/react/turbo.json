{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["public", "compiled"],
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "tags": ["$TURBO_EXTENDS$", "test-react", "test-workers-chromium"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "test:artifact": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:runtime": {
      "dependsOn": ["typegen", "^build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/src/packages/public/otel-vendor.ts",
        "$TURBO_ROOT$/src/packages/public/otel-api-compat.ts"
      ]
    }
  }
}
