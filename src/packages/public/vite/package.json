{
  "name": "@interfere/vite",
  "version": "13.1.5",
  "description": "Vite build plugin and client + server initialization for Interfere.",
  "keywords": [
    "error-tracking",
    "nitro",
    "observability",
    "session-replay",
    "tanstack-start",
    "typescript",
    "vite"
  ],
  "homepage": "https://interfere.com",
  "bugs": "mailto:support@interfere.com",
  "license": "MIT",
  "author": "Interfere <support@interfere.com> (https://interfere.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfere-inc/sdks.git",
    "directory": "src/packages/public/vite"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#request-flush": {
      "workerd": {
        "types": "./dist/internal/server/request/flush.workerd.d.mts",
        "default": "./dist/internal/server/request/flush.workerd.mjs"
      },
      "types": "./dist/internal/server/request/flush.d.mts",
      "default": "./dist/internal/server/request/flush.mjs"
    },
    "#outbound-instrumentation": {
      "workerd": {
        "types": "./dist/internal/server/outbound-instrumentation.workerd.d.mts",
        "default": "./dist/internal/server/outbound-instrumentation.workerd.mjs"
      },
      "types": "./dist/internal/server/outbound-instrumentation.d.mts",
      "default": "./dist/internal/server/outbound-instrumentation.mjs"
    }
  },
  "exports": {
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./init": {
      "types": "./dist/init.d.mts",
      "default": "./dist/init.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "default": "./dist/provider.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./tanstack-start": {
      "types": "./dist/tanstack-start.d.mts",
      "default": "./dist/tanstack-start.mjs"
    },
    "./release": {
      "types": "./dist/release.d.mts",
      "default": "./dist/release.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --no-clean --no-dts --watch",
    "lint": "cd ../../../.. && GOMAXPROCS=2 oxlint --max-warnings=0 --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern --threads=2 src/packages/public/vite",
    "test": "node ../test-config/src/cli.ts run --config ../../../../vitest.config.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@interfere/build": "workspace:^",
    "@interfere/constants": "workspace:^",
    "@interfere/helpers": "workspace:^",
    "@interfere/javascript": "workspace:^",
    "@interfere/react": "workspace:^",
    "@interfere/server-core": "workspace:^",
    "@interfere/types": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@interfere/test-config": "workspace:*",
    "@interfere/test-utils": "workspace:^",
    "@interfere/typescript-config": "workspace:^",
    "@jridgewell/trace-mapping": "catalog:",
    "@msw/cloudflare": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@playwright/test": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "miniflare": "catalog:",
    "msw": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2",
    "@tanstack/react-start": "^1.168.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.2.4"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-start": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "24.x"
  }
}
