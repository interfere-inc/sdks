{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["public"],
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "tags": ["test-vite"]
    },
    "build": {
      "env": ["!VITE_*"],
      "dependsOn": ["$TURBO_EXTENDS$", "build:js"]
    },
    "typegen": {
      "env": ["!VITE_*"]
    },
    "build:js": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/src/packages/public/tsdown.config.ts"
      ]
    }
  }
}
