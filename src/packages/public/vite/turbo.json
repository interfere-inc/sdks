{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["public", "compiled"],
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "tags": ["test-vite"]
    },
    "build": {
      "env": ["!VITE_*"],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/src/packages/public/tsdown.config.ts"
      ]
    },
    "typegen": {
      "env": ["!VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
