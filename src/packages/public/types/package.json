{
  "name": "@interfere/types",
  "version": "11.3.0",
  "description": "TypeScript & Zod types for Interfere",
  "keywords": [
    "logging",
    "observability",
    "typescript"
  ],
  "homepage": "https://interfere.com",
  "bugs": "mailto:support@interfere.com",
  "license": "MIT",
  "author": "Interfere <support@interfere.com> (https://interfere.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interfere-inc/sdks.git",
    "directory": "src/packages/public/types"
  },
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.mjs",
    "dist/**/*.d.cts",
    "dist/**/*.d.mts",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./data/*": {
      "import": {
        "types": "./dist/data/*.d.mts",
        "default": "./dist/data/*.mjs"
      },
      "require": {
        "types": "./dist/data/*.d.cts",
        "default": "./dist/data/*.cjs"
      }
    },
    "./data/source-map-batch": {
      "import": {
        "types": "./dist/data/source/source-map-batch.d.mts",
        "default": "./dist/data/source/source-map-batch.mjs"
      },
      "require": {
        "types": "./dist/data/source/source-map-batch.d.cts",
        "default": "./dist/data/source/source-map-batch.cjs"
      }
    },
    "./data/source-map-diagnostics": {
      "import": {
        "types": "./dist/data/source/source-map-diagnostics.d.mts",
        "default": "./dist/data/source/source-map-diagnostics.mjs"
      },
      "require": {
        "types": "./dist/data/source/source-map-diagnostics.d.cts",
        "default": "./dist/data/source/source-map-diagnostics.cjs"
      }
    },
    "./data/source-map-status": {
      "import": {
        "types": "./dist/data/source/source-map-status.d.mts",
        "default": "./dist/data/source/source-map-status.mjs"
      },
      "require": {
        "types": "./dist/data/source/source-map-status.d.cts",
        "default": "./dist/data/source/source-map-status.cjs"
      }
    },
    "./data/source-map-upload-batch": {
      "import": {
        "types": "./dist/data/source/source-map-upload-batch.d.mts",
        "default": "./dist/data/source/source-map-upload-batch.mjs"
      },
      "require": {
        "types": "./dist/data/source/source-map-upload-batch.d.cts",
        "default": "./dist/data/source/source-map-upload-batch.cjs"
      }
    },
    "./data/source-maps": {
      "import": {
        "types": "./dist/data/source/source-maps.d.mts",
        "default": "./dist/data/source/source-maps.mjs"
      },
      "require": {
        "types": "./dist/data/source/source-maps.d.cts",
        "default": "./dist/data/source/source-maps.cjs"
      }
    },
    "./data/source/*": null,
    "./sdk/plugins/*": {
      "import": {
        "types": "./dist/sdk/plugins/*.d.mts",
        "default": "./dist/sdk/plugins/*.mjs"
      },
      "require": {
        "types": "./dist/sdk/plugins/*.d.cts",
        "default": "./dist/sdk/plugins/*.cjs"
      }
    },
    "./sdk/*": {
      "import": {
        "types": "./dist/sdk/*.d.mts",
        "default": "./dist/sdk/*.mjs"
      },
      "require": {
        "types": "./dist/sdk/*.d.cts",
        "default": "./dist/sdk/*.cjs"
      }
    },
    "./releases/*": {
      "import": {
        "types": "./dist/releases/*.d.mts",
        "default": "./dist/releases/*.mjs"
      },
      "require": {
        "types": "./dist/releases/*.d.cts",
        "default": "./dist/releases/*.cjs"
      }
    },
    "./events/*": {
      "import": {
        "types": "./dist/events/*.d.mts",
        "default": "./dist/events/*.mjs"
      },
      "require": {
        "types": "./dist/events/*.d.cts",
        "default": "./dist/events/*.cjs"
      }
    },
    "./integrations": {
      "import": {
        "types": "./dist/integrations/index.d.mts",
        "default": "./dist/integrations/index.mjs"
      },
      "require": {
        "types": "./dist/integrations/index.d.cts",
        "default": "./dist/integrations/index.cjs"
      }
    },
    "./integrations/platforms/*": {
      "import": {
        "types": "./dist/integrations/platforms/*.d.mts",
        "default": "./dist/integrations/platforms/*.mjs"
      },
      "require": {
        "types": "./dist/integrations/platforms/*.d.cts",
        "default": "./dist/integrations/platforms/*.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --no-clean --no-dts --watch",
    "lint": "cd ../../../.. && GOMAXPROCS=2 oxlint --max-warnings=0 --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern --threads=2 src/packages/public/types",
    "test": "node ../test-config/src/cli.ts run --config ../../../../vitest.config.ts",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@interfere/helpers": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@interfere/test-config": "workspace:*",
    "@interfere/test-utils": "workspace:^",
    "@interfere/typescript-config": "workspace:^",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/baggage-span-processor": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2"
  },
  "engines": {
    "node": "24.x"
  }
}
