{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["public", "compiled"],
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "tsdown.config.ts",
        "$TURBO_ROOT$/src/packages/public/otel-vendor.ts",
        "$TURBO_ROOT$/src/packages/public/otel-api-compat.ts"
      ],
      "outputs": ["$TURBO_EXTENDS$", "dist/**/*.d.cts"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
