{
  "$schema": "https://turbo.build/schema.json",
  "tags": ["public", "compiled"],
  "extends": ["//"],
  "tasks": {
    "test:e2e": {
      "outputs": ["playwright-report/**", "test-results/e2e/**"],
      "tags": ["test-other-browsers"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"],
      "tags": ["$TURBO_EXTENDS$", "test-other-browsers"]
    },
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/src/packages/public/tsdown.config.ts"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "test:runtime": {
      "dependsOn": ["typegen", "^build"],
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}
